{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/auth/(.*)", "dest": "/api/index.js" },
    { "src": "/download/(.*)", "dest": "/api/index.js" },
    { "src": "/success", "dest": "/api/index.js" },
    { "src": "/learners(.*)", "dest": "/api/index.js" },
    { "src": "/parent/(.*)", "dest": "/api/index.js" },
    { "src": "/assessment/(.*)", "dest": "/api/index.js" },
    { "src": "/diagnostics/(.*)", "dest": "/api/index.js" },
    { "src": "/gaps/(.*)", "dest": "/api/index.js" },
    { "src": "/paths/(.*)", "dest": "/api/index.js" },
    { "src": "/tutor/(.*)", "dest": "/api/index.js" },
    { "src": "/stats", "dest": "/api/index.js" },
    { "src": "/admin/(.*)", "dest": "/api/index.js" },
    { "src": "/plans/(.*)", "dest": "/api/index.js" },
    { "src": "/export", "dest": "/api/index.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/free-nclex-checklist", "dest": "/free-nclex-checklist.html" },
    { "src": "/neuro-cheat-sheet", "dest": "/neuro-cheat-sheet.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/404", "dest": "/404.html" },
    { "src": "/content/$", "dest": "/content/index.html" },
    { "src": "/content/(.*)\\.html", "dest": "/content/$1.html" },
    { "src": "/content/(.*)", "dest": "/content/$1.html" },
    { "src": "/downloads/(.*)", "dest": "/downloads/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/compare/(.*)", "dest": "/compare/$1.html" },
    { "src": "/free-framework/(.*)", "dest": "/free-framework/$1" },
    { "src": "/products/(.*)", "dest": "/products/$1" },
    { "src": "/quiz/(.*)", "dest": "/quiz/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/obioma-seo.png", "dest": "/obioma-seo.png" },
    { "src": "/obioma-logo.svg", "dest": "/obioma-logo.svg" },
    { "src": "/apple-touch-icon.png", "dest": "/apple-touch-icon.png" },
    { "src": "/icon-192.png", "dest": "/icon-192.png" },
    { "src": "/icon-512.png", "dest": "/icon-512.png" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "api.obiomacare.com" }],
      "destination": "https://obiomacare.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.obiomacare.com" }],
      "destination": "https://obiomacare.com/:path*",
      "permanent": true
    },
    {
      "source": "/content/child-struggles-math.html",
      "destination": "/content/nclex-clinical-judgment-5-steps.html",
      "permanent": true
    },
    {
      "source": "/content/mastery-based-learning.html",
      "destination": "/content/nclex-clinical-judgment-5-steps.html",
      "permanent": true
    },
    {
      "source": "/content/mastery-vs-grade-levels.html",
      "destination": "/content/nclex-clinical-judgment-5-steps.html",
      "permanent": true
    },
    {
      "source": "/content/prerequisite-skills.html",
      "destination": "/content/nclex-priority-abcde-method.html",
      "permanent": true
    },
    {
      "source": "/content/learning-path-apps.html",
      "destination": "/content/nclex-2-week-study-plan-complete.html",
      "permanent": true
    },
    {
      "source": "/content/personalized-learning-path-guide.html",
      "destination": "/content/nclex-30-day-study-plan.html",
      "permanent": true
    },
    {
      "source": "/content/homeschool-curriculum-planner-comparison.html",
      "destination": "/content/nclex-delegation-assignment-guide.html",
      "permanent": true
    },
    {
      "source": "/content/what-is-mastery-based-learning.html",
      "destination": "/content/why-nursing-students-struggle-nclex-next-gen.html",
      "permanent": true
    },
    {
      "source": "/content/ai-tutors-for-kids-2026.html",
      "destination": "/content/nclex-anxiety-management.html",
      "permanent": true
    },
    {
      "source": "/tools/learning-path-planner.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/prerequisite-checklist.html",
      "destination": "/free-nclex-checklist.html",
      "permanent": true
    },
    {
      "source": "/compare/obioma-vs-khan-academy.html",
      "destination": "/content/obioma-vs-uworld-vs-archer.html",
      "permanent": true
    },
    {
      "source": "/compare/obioma-vs-ixl.html",
      "destination": "/content/obioma-vs-uworld-vs-archer.html",
      "permanent": true
    },
    {
      "source": "/content/30-day-nclex-study-plan.html",
      "destination": "/content/nclex-30-day-study-plan.html",
      "permanent": true
    },
    {
      "source": "/content/sata-questions-strategy.html",
      "destination": "/content/nclex-sata-questions-strategy.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/nurture",
      "schedule": "0 10 * * *"
    }
  ]
}
