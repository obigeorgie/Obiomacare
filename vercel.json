{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/free-framework", "destination": "/public/free-framework.html" },
    { "source": "/success", "destination": "/public/success.html" },
    { "source": "/downloads/(.*)", "destination": "/public/downloads/$1" }
  ]
}
